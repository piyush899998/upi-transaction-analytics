# Copy to .env. Never commit your .env or password.
DATABASE_URL=postgresql://upi:upi_local_dev@localhost:5432/upi_analytics
# When running within docker compose the service name is db (set by compose).
SIMULATION_SEED=20261111
SIMULATION_DAYS=90
SIMULATION_TXNS_PER_BANK_HOUR=36
# True injects a spike at ICICI and a transaction-volume drop at SBI in the most recent completed hour.
DEMO_INCIDENTS=true
# In scheduler mode, create events for the last completed hour, then ingest and detect.
SIMULATE_LIVE_DATA=true
SCHEDULER_INTERVAL_SECONDS=900
FAILURE_RATE_THRESHOLD=0.18
FAILURE_MIN_TXNS=20
FAILURE_MULTIPLIER=2.5
FAILURE_MIN_ABS_INCREASE=0.08
VOLUME_DROP_RATIO=0.55
VOLUME_MIN_BASELINE=20
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_TO=
SMTP_USE_SSL=true
